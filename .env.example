# ==============================================================================
# ReelsMob Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# ── Application Environment & Networking ──────────────────────────────────────
# Application environment: "development" or "production"
# In production, CORS_ORIGINS must be explicitly provided.
# [Optional] Default: development
ENVIRONMENT=development

# Port on which FastAPI backend listens
# [Optional] Default: 8000
PORT=8000

# Public base URL of the backend API (used for OAuth redirects and webhooks)
# [Optional] Default: http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# Allowed CORS origins for browser clients (comma-separated list)
# [Required in production, Optional in development]
# Example: https://app.reelsmob.com,https://api.reelsmob.com
CORS_ORIGINS=http://localhost:9090,http://127.0.0.1:9090,http://localhost:5173,http://127.0.0.1:5173

# Logging configuration
# [Optional] Defaults: LOG_LEVEL=INFO, LOG_FORMAT=console ("json" for structured cloud logging)
LOG_LEVEL=INFO
LOG_FORMAT=console

# ── Supabase Database & Cloud Storage (Required) ──────────────────────────────
# Project URL from Supabase Dashboard -> Project Settings -> API
# [Required]
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Secret Key (used server-side for database & storage ops)
# Note: Keep this secret; never expose it to client-side bundles.
# [Required]
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Alias supported by legacy configs:
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ── Cloud AI Engines (Required for AI Synthesis & Vision) ─────────────────────
# Google Gemini API key for visual frame analysis
# Get a key at: https://aistudio.google.com/
# [Required for Video Keyframe Vision]
GEMINI_API_KEY=your-gemini-api-key-here

# Groq Cloud API key for ultra-fast title & description metadata synthesis
# Get a key at: https://console.groq.com/
# [Required for Viral Metadata Generation]
GROQ_API_KEY=your-groq-api-key-here

# Model ID overrides (providers periodically deprecate/retire model IDs;
# configure these environment variables to swap models without code changes)
# [Optional] Defaults: GEMINI_MODEL=gemini-2.0-flash, GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=openai/gpt-oss-120b

# ── YouTube Data API & OAuth (Optional, for Publishing / Scheduling) ──────────
# YouTube Data API v3 key (for public video and quota inspection)
# [Optional]
YOUTUBE_API_KEY=your-youtube-data-api-key-here

# Google OAuth 2.0 Client credentials (used if client_secrets.json is not present)
# [Optional]
YOUTUBE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Frontend React Build Settings ─────────────────────────────────────────────
# Base URL for API requests when frontend and backend are hosted on different domains
# Leave blank or omit when using the integrated SPA server or Vite proxy.
# [Optional] Default: ""
VITE_API_BASE_URL=

# Proxy target for Vite dev server (e.g. running 'npm run dev' on frontend)
# [Optional] Default: http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000
